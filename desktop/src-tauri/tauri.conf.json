{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InterBrain",
  "version": "0.16.0",
  "identifier": "org.projectliminality.interbrain",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "first-run",
        "title": "Welcome to InterBrain",
        "url": "index.html#first-run",
        "width": 560,
        "height": 540,
        "resizable": false,
        "center": true,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "deb",
      "appimage"
    ],
    "resources": {
      "resources/plugin/manifest.json": "plugin/manifest.json",
      "resources/plugin/main.js": "plugin/main.js",
      "resources/plugin/styles.css": "plugin/styles.css",
      "resources/plugin/interbrain.css": "plugin/interbrain.css",
      "resources/plugin/DreamNode-template/**/*": "plugin/DreamNode-template/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Knowledge gardening companion",
    "longDescription": "InterBrain transforms personal knowledge management into collective knowledge gardening.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {}
}